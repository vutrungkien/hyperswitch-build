+mod line_items_tests {
+    use super::*;
+
+    fn usd(minor: i64) -> OrderAmount {
+        paypal_money(MinorUnit::new(minor), storage_enums::Currency::USD).expect("money")
+    }
+
+    fn generic(total: i64) -> (OrderRequestAmount, Vec<ItemDetails>) {
+        let amount = OrderRequestAmount {
+            currency_code: storage_enums::Currency::USD,
+            value: usd(total).value,
+            breakdown: AmountBreakdown {
+                item_total: usd(total),
+                tax_total: None,
+                shipping: Some(usd(0)),
+                handling: None,
+                discount: None,
+            },
+        };
+        let items = vec![ItemDetails {
+            name: "Payment for invoice pay_x_1".to_string(),
+            quantity: ORDER_QUANTITY,
+            unit_amount: usd(total),
+            tax: None,
+        }];
+        (amount, items)
+    }
+
+    // diesel_models::types::OrderDetailsWithAmount (re-exported by hyperswitch_domain_models::types) has no Default: every field spelled out
+    fn line(name: &str, quantity: u16, unit: i64, total: Option<i64>, category: Option<&str>) -> OrderDetailsWithAmount {
+        OrderDetailsWithAmount {
+            product_name: name.to_string(),
+            quantity,
+            amount: MinorUnit::new(unit),
+            requires_shipping: None,
+            product_img_link: None,
+            product_id: None,
+            category: category.map(str::to_string),
+            sub_category: None,
+            brand: None,
+            product_type: None,
+            product_tax_code: None,
+            tax_rate: None,
+            total_tax_amount: None,
+            description: None,
+            sku: None,
+            upc: None,
+            commodity_code: None,
+            unit_of_measure: None,
+            total_amount: total.map(MinorUnit::new),
+            unit_discount_amount: None,
+        }
+    }
+
+    fn build(total: i64, shipping_cost: Option<i64>, lines: Option<Vec<OrderDetailsWithAmount>>) -> serde_json::Value {
+        let (amount, items) = generic(total);
+        let unit = purchase_lines(amount, items, MinorUnit::new(total), shipping_cost.map(MinorUnit::new), lines.as_deref()).expect("purchase unit");
+        serde_json::to_value(unit).expect("json")
+    }
+
+    fn full_cart() -> Vec<OrderDetailsWithAmount> {
+        vec![
+            line("T-shirt", 1, 2990, Some(2990), None),
+            line("Hoodie", 1, 4990, Some(4990), None),
+            line("Shipping", 1, 500, Some(500), Some("shipping")),
+            line("Tax", 1, 680, Some(680), Some("tax")),
+            line("Gift wrap", 1, 200, Some(200), Some("fee")),
+        ]
+    }
+
+    #[test]
+    fn reconciled_lines_become_items_and_breakdown() {
+        let v = build(9360, None, Some(full_cart()));
+        assert_eq!(v["amount"]["value"], "93.60");
+        let b = &v["amount"]["breakdown"];
+        assert_eq!(b["item_total"]["value"], "79.80");
+        assert_eq!(b["shipping"]["value"], "5.00");
+        assert_eq!(b["tax_total"]["value"], "6.80");
+        assert_eq!(b["handling"]["value"], "2.00", "fees go to handling");
+        assert!(b.get("discount").is_none(), "{b}");
+        let items = v["items"].as_array().expect("items");
+        assert_eq!(items.len(), 2);
+        assert_eq!(items[0]["name"], "T-shirt");
+        assert_eq!(items[0]["quantity"], 1);
+        assert_eq!(items[0]["unit_amount"]["value"], "29.90");
+        assert_eq!(items[1]["name"], "Hoodie");
+        assert_eq!(items[1]["unit_amount"]["value"], "49.90");
+        assert_eq!(items[1]["unit_amount"]["currency_code"], "USD");
+    }
+
+    #[test]
+    fn floor_remainder_goes_to_handling() {
+        let v = build(2599, None, Some(vec![line("Tee", 3, 866, Some(2599), None)]));
+        assert_eq!(v["items"][0]["quantity"], 3);
+        assert_eq!(v["items"][0]["unit_amount"]["value"], "8.66");
+        assert_eq!(v["amount"]["breakdown"]["item_total"]["value"], "25.98");
+        assert_eq!(v["amount"]["breakdown"]["handling"]["value"], "0.01");
+        assert_eq!(v["amount"]["value"], "25.99");
+        let v = build(8135, None, Some(vec![line("Tee", 4, 2033, Some(8135), None)]));
+        assert_eq!(v["amount"]["breakdown"]["handling"]["value"], "0.03");
+        assert_eq!(v["amount"]["breakdown"]["item_total"]["value"], "81.32");
+    }
+
+    #[test]
+    fn lines_that_do_not_reconcile_fall_back_to_the_generic_item() {
+        let generic_shape = |v: &serde_json::Value, total: &str| {
+            assert_eq!(v["items"][0]["name"], "Payment for invoice pay_x_1", "{v}");
+            assert_eq!(v["items"].as_array().map(Vec::len), Some(1));
+            assert_eq!(v["items"][0]["unit_amount"]["value"], total);
+            assert_eq!(v["amount"]["breakdown"]["item_total"]["value"], total);
+            assert_eq!(v["amount"]["breakdown"]["shipping"]["value"], "0.00");
+            assert!(v["amount"]["breakdown"].get("handling").is_none());
+        };
+        generic_shape(&build(2700, None, Some(vec![line("Tee", 3, 866, Some(2700), None)])), "27.00"); // remainder 1.02 > 3 cents
+        generic_shape(&build(8135, None, Some(vec![line("Tee", 4, 2034, Some(8135), None)])), "81.35"); // rounded-up unit price: negative remainder
+        generic_shape(&build(2990, None, Some(vec![line("Tee", 1, 2990, None, None), line("Ship", 1, 9000, None, Some("shipping"))])), "29.90");
+        generic_shape(&build(2990, None, Some(vec![line("Tee", 1, -2990, Some(-2990), None), line("Fee", 1, 5980, None, Some("fee"))])), "29.90");
+    }
+
+    #[test]
