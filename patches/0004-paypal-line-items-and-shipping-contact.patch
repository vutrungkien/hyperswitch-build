+fn paypal_money(
+    minor: MinorUnit,
+    currency: storage_enums::Currency,
+) -> Result<OrderAmount, error_stack::Report<errors::ConnectorError>> {
+    Ok(OrderAmount {
+        currency_code: currency,
+        value: utils::convert_amount(&StringMajorUnitForConnector, minor, currency)?,
+    })
+}
+
+fn paypal_money_if_positive(
+    minor: MinorUnit,
+    currency: storage_enums::Currency,
+) -> Result<Option<OrderAmount>, error_stack::Report<errors::ConnectorError>> {
+    if minor.get_amount_as_i64() > 0 {
+        paypal_money(minor, currency).map(Some)
+    } else {
+        Ok(None)
+    }
+}
+
+struct LineSplit {
+    items: Vec<(String, u16, MinorUnit)>,
+    item_total: MinorUnit,
+    shipping: MinorUnit,
+    tax: MinorUnit,
+    handling: MinorUnit,
+    discount: MinorUnit,
+}
+
+/// `None` = the lines do not reconcile with `total` (or there is no product line): keep the upstream single item.
+fn split_order_details(total: MinorUnit, lines: &[OrderDetailsWithAmount]) -> Option<LineSplit> {
+    let mut items: Vec<(String, u16, MinorUnit)> = Vec::new();
+    let (mut shipping, mut tax, mut fees, mut discount) = (
+        MinorUnit::zero(),
+        MinorUnit::zero(),
+        MinorUnit::zero(),
+        MinorUnit::zero(),
+    );
+    let mut quantity_sum: i64 = 0;
+    for line in lines {
+        let tagged = line.total_amount.unwrap_or(line.amount);
+        match line
+            .category
+            .as_deref()
+            .filter(|category| LINE_TAGS.contains(category))
+        {
+            Some("shipping") => shipping = shipping + tagged,
+            Some("tax") => tax = tax + tagged,
+            Some("fee") => fees = fees + tagged,
+            Some("discount") => discount = discount + tagged,
+            _ => {
+                if line.quantity == 0 || line.amount.get_amount_as_i64() == 0 {
+                    continue; // a free line changes no sum; PayPal gives no promise for unit_amount 0.00
+                }
+                if line.quantity > ITEM_QUANTITY_MAX || line.amount.get_amount_as_i64() < 0 {
+                    return None;
+                }
+                let name = line
+                    .product_name
+                    .trim()
+                    .chars()
+                    .take(ITEM_NAME_MAX_CHARS)
+                    .collect::<String>();
+                let name = name.trim_end();
+                let name = if name.is_empty() { "Item" } else { name };
+                items.push((name.to_string(), line.quantity, line.amount));
+                quantity_sum += i64::from(line.quantity);
+            }
+        }
+    }
+    if items.is_empty()
+        || [shipping, tax, fees, discount]
+            .iter()
+            .any(|value| value.get_amount_as_i64() < 0)
+    {
+        return None;
+    }
+    let item_total = items
+        .iter()
+        .map(|(_, quantity, unit)| *unit * *quantity)
+        .sum::<MinorUnit>();
+    let remainder = total - item_total - shipping - tax - fees + discount;
+    if remainder.get_amount_as_i64() < 0 || remainder.get_amount_as_i64() > quantity_sum {
+        return None;
+    }
+    Some(LineSplit {
+        items,
+        item_total,
+        shipping,
+        tax,
+        handling: fees + remainder,
+        discount,
+    })
+}
+
+/// `amount` + `items` of one purchase unit (the other fields stay `Default`, the caller sets them).
+/// `generic_*` are upstream's single-item values: they give the currency and the fallback item name.
+/// Fallback = upstream shape with `item_total = total - shipping_cost` in EVERY flow (upstream's redirect
+/// flow put the whole amount into `item_total`, which PayPal refuses as soon as `shipping_cost` > 0).
+fn purchase_lines(
+    generic_amount: OrderRequestAmount,
+    generic_items: Vec<ItemDetails>,
+    total: MinorUnit,
+    shipping_cost: Option<MinorUnit>,
+    order_details: Option<&[OrderDetailsWithAmount]>,
+) -> Result<PurchaseUnitRequest, error_stack::Report<errors::ConnectorError>> {
+    let currency = generic_amount.currency_code;
+    let shipping_cost = shipping_cost.unwrap_or(MinorUnit::zero());
+    if let Some(split) =
+        order_details.and_then(|lines| split_order_details(total - shipping_cost, lines))
+    {
+        let items = split
+            .items
+            .iter()
+            .map(|(name, quantity, unit)| {
+                Ok(ItemDetails {
+                    name: name.clone(),
+                    quantity: *quantity,
+                    unit_amount: paypal_money(*unit, currency)?,
+                    tax: None,
+                })
+            })
+            .collect::<Result<Vec<_>, error_stack::Report<errors::ConnectorError>>>()?;
+        return Ok(PurchaseUnitRequest {
+            amount: OrderRequestAmount {
+                currency_code: currency,
+                value: utils::convert_amount(&StringMajorUnitForConnector, total, currency)?,
+                breakdown: AmountBreakdown {
+                    item_total: paypal_money(split.item_total, currency)?,
+                    tax_total: paypal_money_if_positive(split.tax, currency)?,
+                    shipping: Some(paypal_money(split.shipping + shipping_cost, currency)?),
+                    handling: paypal_money_if_positive(split.handling, currency)?,
+                    discount: paypal_money_if_positive(split.discount, currency)?,
+                },
+            },
+            items,
+            ..Default::default()
+        });
+    }
+    if order_details.is_some_and(|lines| !lines.is_empty()) {
+        router_env::logger::warn!(
+            "paypal: order_details do not reconcile with the amount, sending the generic single item"
+        );
+    }
+    let item_total = total - shipping_cost;
+    let name = generic_items
+        .into_iter()
+        .next()
+        .map(|item| item.name)
+        .unwrap_or_else(|| "Item".to_string());
+    Ok(PurchaseUnitRequest {
+        amount: OrderRequestAmount {
+            currency_code: currency,
+            value: utils::convert_amount(&StringMajorUnitForConnector, total, currency)?,
+            breakdown: AmountBreakdown {
+                item_total: paypal_money(item_total, currency)?,
+                tax_total: None,
+                shipping: Some(paypal_money(shipping_cost, currency)?),
+                handling: None,
+                discount: None,
+            },
+        },
+        items: vec![ItemDetails {
+            name,
+            quantity: ORDER_QUANTITY,
+            unit_amount: paypal_money(item_total, currency)?,
+            tax: None,
+        }],
+        ..Default::default()
+    })
+}
