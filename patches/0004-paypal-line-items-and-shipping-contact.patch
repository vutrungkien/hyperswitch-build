+// ---- mergesk patch paypal-line-items (plan 32) --------------------------------------------------
+// Upstream sends one item "Payment for invoice <ref>" (quantity 1) and puts the whole amount into
+// `item_total` - in the popup/redirect flow even when `shipping_cost` is set, which PayPal would refuse with
+// 422 once a real shipping value is present. The merchant plugin now sends `order_details`: product lines
+// (quantity, floor unit price, `total_amount`, `product_id`) and lines tagged by `category` =
+// shipping | tax | fee | discount. They become PayPal items + amount breakdown ONLY when they reconcile to the
+// cent with the amount charged (value = item_total + shipping + tax_total + handling - discount; the remainder
+// of the floor division goes to `handling`, 0 <= remainder <= sum of quantities); otherwise the upstream single
+// item is kept and a warning is logged. Nothing is ever blocked (spec plan 32 D7 / R6). The recipient phone
+// (`shipping.phone_number`: country code + national number, both required by PayPal) and the second address
+// line travel with the same patch (N1 / R7). New code and its tests live here, next to `PurchaseUnitRequest`,
+// so every mergesk patch keeps applying and reverse-applying on its own.
+const ITEM_NAME_MAX_CHARS: usize = 127;
+const ITEM_QUANTITY_MAX: u16 = 9999;
+const LINE_TAGS: [&str; 4] = ["shipping", "tax", "fee", "discount"];
+
+/// PayPal `purchase_units[].shipping`: upstream's address + name (`ShippingAddress`, flattened) plus the
+/// recipient phone - a wrapper, so the structs and tests of the earlier patches stay untouched.
+#[derive(Default, Debug, Serialize, Eq, PartialEq)]
+pub struct ShippingDetails {
+    #[serde(flatten)]
+    shipping: ShippingAddress,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    phone_number: Option<PaypalPhoneNumber>,
+}
+
+#[derive(Debug, Serialize, Eq, PartialEq)]
+pub struct PaypalPhoneNumber {
+    country_code: String,
+    national_number: Secret<String>,
+}
+
+/// Recipient phone for PayPal: `country_code` = the 1-3 digits of `PhoneDetails.country_code` ("+1" -> "1"),
+/// `national_number` = the digits of the number (a number carrying its own "+<cc>" prefix loses that prefix),
+/// 1-14 digits. A missing or malformed part -> no phone at all (PayPal requires both fields).
+fn shipping_phone(
+    shipping: Option<&hyperswitch_domain_models::address::Address>,
+) -> Option<PaypalPhoneNumber> {
+    let phone = shipping?.phone.as_ref()?;
+    let country_code = phone
+        .country_code
+        .as_deref()?
+        .chars()
+        .filter(char::is_ascii_digit)
+        .collect::<String>();
+    if country_code.is_empty() || country_code.len() > 3 {
+        return None;
+    }
+    let raw = phone.number.as_ref()?.clone().expose();
+    let digits = raw.chars().filter(char::is_ascii_digit).collect::<String>();
+    let national = if raw.trim_start().starts_with('+')
+        && digits.len() > country_code.len()
+        && digits.starts_with(&country_code)
+    {
+        digits[country_code.len()..].to_string()
+    } else {
+        digits
+    };
+    if national.is_empty() || national.len() > 14 {
+        return None;
+    }
+    Some(PaypalPhoneNumber {
+        country_code,
+        national_number: Secret::new(national),
+    })
+}
