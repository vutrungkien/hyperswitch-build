+    fn domain(line2: Option<&str>, phone: Option<(&str, Option<&str>)>) -> DomainAddress {
+        DomainAddress {
+            address: Some(AddressDetails {
+                city: Some("Austin".to_string()),
+                country: Some(enums::CountryAlpha2::US),
+                line1: secret("9 Oak Ave"),
+                line2: line2.and_then(secret),
+                zip: secret("78701"),
+                first_name: secret("Bob"),
+                last_name: secret("Recipient"),
+                ..Default::default()
+            }),
+            phone: phone.map(|(number, country_code)| PhoneDetails {
+                number: secret(number),
+                country_code: country_code.map(str::to_string),
+            }),
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn line2_is_sent_trimmed_and_left_out_when_blank() {
+        let line2_of = |value: Option<&str>| {
+            get_address_info(Some(&domain(value, None)))
+                .expect("address")
+                .address_line_2
+                .map(|line2| line2.expose())
+        };
+        assert_eq!(line2_of(Some(" Apt 5 ")), Some("Apt 5".to_string()));
+        for blank in [None, Some(""), Some("  ")] {
+            assert_eq!(line2_of(blank), None, "line2 {blank:?}");
+        }
+        assert_eq!(line2_of(Some(&"x".repeat(400))).map(|line2| line2.chars().count()), Some(300));
+        let json = serde_json::to_value(get_address_info(Some(&domain(None, None))).expect("address")).expect("json");
+        assert!(json.get("address_line_2").is_none(), "blank line2 must not be serialized: {json}");
+        let json = serde_json::to_value(get_address_info(Some(&domain(Some("Apt 5"), None))).expect("address")).expect("json");
+        assert_eq!(json["address_line_2"], "Apt 5");
+        assert_eq!(json["address_line_1"], "9 Oak Ave");
+        assert_eq!(json["admin_area_2"], "Austin");
+    }
+
+    #[test]
+    fn phone_needs_country_code_and_digits() {
+        let phone_of = |number: &str, country_code: Option<&str>| {
+            shipping_phone(Some(&domain(None, Some((number, country_code)))))
+                .map(|phone| (phone.country_code, phone.national_number.expose()))
+        };
+        assert_eq!(phone_of("(214) 555-0100", Some("1")), Some(("1".to_string(), "2145550100".to_string())));
+        assert_eq!(phone_of("0911 222 333", Some("+84")), Some(("84".to_string(), "0911222333".to_string())));
+        assert_eq!(phone_of("+1 408 555 1234", Some("1")), Some(("1".to_string(), "4085551234".to_string())), "own +cc prefix removed");
+        assert_eq!(phone_of("+44 20 7946 0958", Some("44")), Some(("44".to_string(), "2079460958".to_string())));
+        assert_eq!(phone_of("1408 555 1234", Some("1")), Some(("1".to_string(), "14085551234".to_string())), "no + sign: digits kept");
+        assert_eq!(phone_of("2145550100", None), None, "no country code -> no phone");
+        assert_eq!(phone_of("2145550100", Some("")), None);
+        assert_eq!(phone_of("2145550100", Some("1234")), None);
+        assert_eq!(phone_of("", Some("1")), None);
+        assert_eq!(phone_of("abc", Some("1")), None);
+        assert_eq!(phone_of(&"9".repeat(15), Some("1")), None, "more than 14 digits");
+        assert_eq!(phone_of(&"9".repeat(14), Some("1")).map(|phone| phone.1.len()), Some(14));
+        assert!(shipping_phone(None).is_none());
+        assert!(shipping_phone(Some(&DomainAddress::default())).is_none());
+    }
+
+    #[test]
+    fn serialized_shipping_details_carry_phone_and_line2() {
+        let d = domain(Some("Apt 5"), Some(("2145550100", Some("1"))));
+        let details = ShippingDetails {
+            shipping: ShippingAddress {
+                address: get_address_info(Some(&d)),
+                name: Some(ShippingName {
+                    full_name: shipping_full_name(Some(&d)),
+                }),
+            },
+            phone_number: shipping_phone(Some(&d)),
+        };
+        let json = serde_json::to_value(&details).expect("json");
+        assert_eq!(json["address"]["address_line_2"], "Apt 5");
+        assert_eq!(json["address"]["admin_area_2"], "Austin");
+        assert_eq!(json["name"]["full_name"], "Bob Recipient");
+        assert_eq!(json["phone_number"]["country_code"], "1");
+        assert_eq!(json["phone_number"]["national_number"], "2145550100");
+        let no_phone = ShippingDetails {
+            shipping: ShippingAddress {
+                address: get_address_info(Some(&domain(None, None))),
+                name: None,
+            },
+            phone_number: None,
+        };
+        let json = serde_json::to_value(&no_phone).expect("json");
+        assert!(json.get("phone_number").is_none(), "{json}");
+        assert!(json["address"].get("address_line_2").is_none());
+        assert!(json["name"].is_null());
+    }
+}
