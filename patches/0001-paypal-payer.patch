+// ---- mergesk patch paypal-payer ----------------------------------------------------------------
+// PayPal Orders v2 `payer` object. It is only sent when the connector metadata does not contain
+// `send_payer: false`. PayPal rejects the whole order (422) on malformed payer data, so every part is
+// validated and dropped when unsure (see `build_payer`).
+#[derive(Debug, Serialize, PartialEq, Eq)]
+pub struct PayerName {
+    #[serde(skip_serializing_if = "Option::is_none")]
+    given_name: Option<Secret<String>>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    surname: Option<Secret<String>>,
+}
+
+#[derive(Debug, Serialize, PartialEq, Eq)]
+pub struct PayerPhoneNumber {
+    national_number: Secret<String>,
+}
+
+#[derive(Debug, Serialize, PartialEq, Eq)]
+pub enum PayerPhoneType {
+    #[serde(rename = "MOBILE")]
+    Mobile,
+}
+
+#[derive(Debug, Serialize, PartialEq, Eq)]
+pub struct PayerPhone {
+    phone_type: PayerPhoneType,
+    phone_number: PayerPhoneNumber,
+}
+
+#[derive(Debug, Serialize, PartialEq, Eq)]
+pub struct PayerAddress {
+    #[serde(skip_serializing_if = "Option::is_none")]
+    address_line_1: Option<Secret<String>>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    address_line_2: Option<Secret<String>>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    admin_area_2: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    admin_area_1: Option<Secret<String>>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    postal_code: Option<Secret<String>>,
+    country_code: enums::CountryAlpha2,
+}
+
+#[derive(Debug, Serialize, PartialEq, Eq)]
+pub struct PaypalPayer {
+    #[serde(skip_serializing_if = "Option::is_none")]
+    email_address: Option<Email>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    name: Option<PayerName>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    phone: Option<PayerPhone>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    address: Option<PayerAddress>,
+}
+
+/// Raw buyer fields as collected from the payment (billing address + e-mail + phone).
+pub struct PayerInput {
+    pub email: Option<Email>,
+    pub first_name: Option<Secret<String>>,
+    pub last_name: Option<Secret<String>>,
+    pub phone: Option<Secret<String>>,
+    pub line1: Option<Secret<String>>,
+    pub line2: Option<Secret<String>>,
+    pub city: Option<String>,
+    pub state: Option<Secret<String>>,
+    pub zip: Option<Secret<String>>,
+    pub country: Option<enums::CountryAlpha2>,
+}
+
+fn clip_secret(value: Option<Secret<String>>, max: usize) -> Option<Secret<String>> {
+    value.and_then(|v| {
+        let trimmed: String = v.expose().trim().chars().take(max).collect();
+        if trimmed.is_empty() {
+            None
+        } else {
+            Some(Secret::new(trimmed))
+        }
+    })
 }
 
+/// Build the PayPal `payer` object, dropping every part that could make PayPal reject the order.
+pub fn build_payer(input: PayerInput) -> Option<PaypalPayer> {
+    let name = match (
+        clip_secret(input.first_name, 140),
+        clip_secret(input.last_name, 140),
+    ) {
+        (None, None) => None,
+        (given_name, surname) => Some(PayerName {
+            given_name,
+            surname,
+        }),
+    };
+    let phone = input.phone.and_then(|p| {
+        let digits: String = p
+            .expose()
+            .chars()
+            .filter(|c| c.is_ascii_digit())
+            .collect();
+        (!digits.is_empty() && digits.len() <= 14).then(|| PayerPhone {
+            phone_type: PayerPhoneType::Mobile,
+            phone_number: PayerPhoneNumber {
+                national_number: Secret::new(digits),
+            },
+        })
+    });
+    let address = input.country.and_then(|country_code| {
+        let admin_area_1 = clip_secret(input.state, 300);
+        let postal_code = clip_secret(input.zip, 60);
+        let needs_state_and_zip = matches!(
+            country_code,
+            enums::CountryAlpha2::US | enums::CountryAlpha2::CA
+        );
+        let state_is_code = admin_area_1
+            .as_ref()
+            .map(|s| s.clone().expose().len() == 2)
+            .unwrap_or(false);
+        if needs_state_and_zip && (postal_code.is_none() || !state_is_code) {
+            return None;
+        }
+        Some(PayerAddress {
+            address_line_1: clip_secret(input.line1, 300),
+            address_line_2: clip_secret(input.line2, 300),
+            admin_area_2: input
+                .city
+                .map(|c| c.trim().chars().take(120).collect::<String>())
+                .filter(|c| !c.is_empty()),
+            admin_area_1,
+            postal_code,
+            country_code,
+        })
+    });
+    if input.email.is_none() && name.is_none() && phone.is_none() && address.is_none() {
+        return None;
+    }
+    Some(PaypalPayer {
+        email_address: input.email,
+        name,
+        phone,
+        address,
+    })
+}
+
+/// Connector metadata `{"send_payer": false}` (or "false"/"off"/"0"/"no") disables the payer block
+/// without a rebuild; anything else (including no metadata) keeps it enabled.
+pub fn payer_enabled(meta: &Option<common_utils::pii::SecretSerdeValue>) -> bool {
+    meta.as_ref()
+        .and_then(|m| m.clone().expose().get("send_payer").cloned())
+        .map_or(true, |v| match v {
+            serde_json::Value::Bool(b) => b,
+            serde_json::Value::String(s) => !matches!(
+                s.trim().to_ascii_lowercase().as_str(),
+                "false" | "off" | "0" | "no"
+            ),
+            _ => true,
+        })
+}
+
+pub fn payer_from_router_data<F, T>(
+    rd: &RouterData<F, T, PaymentsResponseData>,
+) -> Option<PaypalPayer> {
+    if !payer_enabled(&rd.connector_meta_data) {
+        return None;
+    }
+    build_payer(PayerInput {
+        email: rd.get_optional_billing_email(),
+        first_name: rd.get_optional_billing_first_name(),
+        last_name: rd.get_optional_billing_last_name(),
+        phone: rd.get_optional_billing_phone_number(),
+        line1: rd.get_optional_billing_line1(),
+        line2: rd.get_optional_billing_line2(),
+        city: rd.get_optional_billing_city(),
+        state: rd.get_optional_billing_state(),
+        zip: rd.get_optional_billing_zip(),
+        country: rd.get_optional_billing_country(),
+    })
+}
+// ---- end mergesk patch paypal-payer ------------------------------------------------------------
