+#[cfg(test)]
+mod payer_tests {
+    // mergesk patch paypal-payer
+    use super::*;
+
+    fn secret(v: &str) -> Option<Secret<String>> {
+        Some(Secret::new(v.to_string()))
+    }
+
+    fn full_us() -> PayerInput {
+        PayerInput {
+            email: Email::try_from("buyer@example.com".to_string()).ok(),
+            first_name: secret("Proto"),
+            last_name: secret("Buyer"),
+            phone: secret("+1 (408) 555-1234"),
+            line1: secret("1 Test Street"),
+            line2: secret(""),
+            city: Some("San Jose".to_string()),
+            state: secret("CA"),
+            zip: secret("95131"),
+            country: Some(enums::CountryAlpha2::US),
+        }
+    }
+
+    #[test]
+    fn full_us_payer_has_all_parts() {
+        let payer = build_payer(full_us()).expect("payer");
+        assert!(payer.email_address.is_some());
+        let name = payer.name.expect("name");
+        assert_eq!(name.given_name.map(|s| s.expose()), Some("Proto".to_string()));
+        assert_eq!(name.surname.map(|s| s.expose()), Some("Buyer".to_string()));
+        assert_eq!(
+            payer.phone.expect("phone").phone_number.national_number.expose(),
+            "14085551234"
+        );
+        let address = payer.address.expect("address");
+        assert_eq!(address.country_code, enums::CountryAlpha2::US);
+        assert_eq!(address.postal_code.map(|s| s.expose()), Some("95131".to_string()));
+        assert_eq!(address.admin_area_1.map(|s| s.expose()), Some("CA".to_string()));
+        assert!(address.address_line_2.is_none(), "empty line2 dropped");
+        assert_eq!(address.admin_area_2, Some("San Jose".to_string()));
+    }
+
+    #[test]
+    fn us_without_zip_drops_address_but_keeps_rest() {
+        let mut input = full_us();
+        input.zip = None;
+        let payer = build_payer(input).expect("payer");
+        assert!(payer.address.is_none());
+        assert!(payer.name.is_some() && payer.email_address.is_some());
+    }
+
+    #[test]
+    fn us_with_long_state_drops_address() {
+        let mut input = full_us();
+        input.state = secret("California");
+        assert!(build_payer(input).expect("payer").address.is_none());
+    }
+
+    #[test]
+    fn non_us_country_without_zip_keeps_address() {
+        let mut input = full_us();
+        input.country = Some(enums::CountryAlpha2::VN);
+        input.zip = None;
+        input.state = secret("Ho Chi Minh");
+        let address = build_payer(input).expect("payer").address.expect("address");
+        assert_eq!(address.country_code, enums::CountryAlpha2::VN);
+        assert!(address.postal_code.is_none());
+    }
+
+    #[test]
+    fn phone_too_long_or_empty_is_dropped() {
+        let mut input = full_us();
+        input.phone = secret("123456789012345");
+        assert!(build_payer(input).expect("payer").phone.is_none());
+        let mut input = full_us();
+        input.phone = secret("+-- ");
+        assert!(build_payer(input).expect("payer").phone.is_none());
+    }
+
+    #[test]
+    fn long_name_is_clipped_to_140() {
+        let mut input = full_us();
+        input.first_name = secret(&"a".repeat(200));
+        let name = build_payer(input).expect("payer").name.expect("name");
+        assert_eq!(name.given_name.map(|s| s.expose().len()), Some(140));
+    }
+
+    #[test]
+    fn empty_input_gives_none() {
+        let input = PayerInput {
+            email: None,
+            first_name: secret("  "),
+            last_name: None,
+            phone: None,
+            line1: None,
+            line2: None,
+            city: None,
+            state: None,
+            zip: None,
+            country: None,
+        };
+        assert!(build_payer(input).is_none());
+    }
+
+    #[test]
+    fn payer_enabled_reads_connector_metadata() {
+        let meta = |v: serde_json::Value| Some(Secret::new(v));
+        assert!(payer_enabled(&None));
+        assert!(payer_enabled(&meta(serde_json::json!({}))));
+        assert!(payer_enabled(&meta(serde_json::json!({"send_payer": true}))));
+        assert!(payer_enabled(&meta(serde_json::json!({"send_payer": "yes"}))));
+        assert!(!payer_enabled(&meta(serde_json::json!({"send_payer": false}))));
+        assert!(!payer_enabled(&meta(serde_json::json!({"send_payer": "off"}))));
+        assert!(!payer_enabled(&meta(serde_json::json!({"send_payer": "false"}))));
+    }
+
+    #[test]
+    fn request_without_payer_has_no_payer_key() {
+        let request = PaypalPaymentsRequest {
+            intent: PaypalPaymentIntent::Capture,
+            purchase_units: vec![],
+            payment_source: None,
+            payer: None,
+        };
+        let json = serde_json::to_string(&request).expect("json");
+        assert!(!json.contains("payer"), "{json}");
+        let request = PaypalPaymentsRequest {
+            intent: PaypalPaymentIntent::Capture,
+            purchase_units: vec![],
+            payment_source: None,
+            payer: build_payer(full_us()),
+        };
+        let json = serde_json::to_string(&request).expect("json");
+        assert!(json.contains("\"payer\":{\"email_address\":\"buyer@example.com\""), "{json}");
+        assert!(json.contains("\"phone_type\":\"MOBILE\""), "{json}");
+    }
+}
