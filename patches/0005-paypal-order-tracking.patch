+/// mergesk patch 0005 (plan 33): `POST /payments/{payment_id}/track` - send shipment tracking to the connector of a captured payment.
+#[cfg(feature = "v1")]
+#[instrument(skip_all, fields(flow = ?Flow::PaymentsTrack, payment_id))]
+pub async fn payments_track(
+    state: web::Data<app::AppState>,
+    req: actix_web::HttpRequest,
+    json_payload: web::Json<payment_types::PaymentsTrackRequest>,
+    path: web::Path<common_utils::id_type::PaymentId>,
+) -> impl Responder {
+    let flow = Flow::PaymentsTrack;
+    let payment_id = path.into_inner();
+    let payload = payment_types::PaymentsTrackRequest {
