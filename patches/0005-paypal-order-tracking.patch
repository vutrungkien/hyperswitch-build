diff --git a/crates/router/src/core/track.rs b/crates/router/src/core/track.rs
new file mode 100644
index 0000000..a15499d
--- /dev/null
+++ b/crates/router/src/core/track.rs
@@ -0,0 +1,400 @@
+//! mergesk patch 0005 (plan 33): send the shipment tracking of a captured payment to its connector
+//! (`POST /payments/{payment_id}/track`; PayPal `POST /v2/checkout/orders/{id}/track`).
+//!
+//! Shaped like a refund (core/refunds.rs `trigger_refund_to_gateway`): payment intent + last successful attempt of the
+//! merchant, connector account of that attempt, access token, one connector call, nothing stored. Outcome:
+//! connector accepted -> 200 `status: sent` + tracker id; connector refused (4xx except 429) -> 200 `status: failed` +
+//! its error code/message (definite, the caller must not retry blindly); connector/transport failure (5xx, 429, timeout)
+//! -> `ExternalConnectorError` with the connector's status (retry later); the attempt lacks the capture id / connector
+//! metadata -> `PreconditionFailed` (IR_16, definite); connector without a Track integration -> `FlowNotSupported`.
+
+use api_models::payments::{PaymentsTrackRequest, PaymentsTrackResponse, PaymentsTrackStatus};
+use common_utils::ext_traits::ValueExt;
+use error_stack::{report, ResultExt};
+use external_services::grpc_client::LineageIds;
+use hyperswitch_domain_models::payments::HeaderPayload;
+use hyperswitch_interfaces::consts as interfaces_consts;
+use router_env::{instrument, tracing};
+
+use crate::{
+    core::{
+        errors::{self, RouterResponse, RouterResult, StorageErrorExt},
+        payments::{self, access_token, gateway::context as gateway_context, helpers},
+    },
+    routes::SessionState,
+    services,
+    types::{self, api, domain, storage, storage::enums, PaymentAddress},
+    utils::{self, OptionExt},
+};
+
+const FLOW_NAME: &str = "Track";
+/// Put in the router data before the connector call; a connector whose `Track` integration is the default one builds no request and
+/// hands the router data back unchanged, so this message tells "not implemented" apart from a connector refusal.
+const NOT_IMPLEMENTED_MESSAGE: &str = "track: the connector built no request";
+
+#[instrument(skip_all)]
+pub async fn payments_track_core(
+    state: SessionState,
+    platform: domain::Platform,
+    req: PaymentsTrackRequest,
+) -> RouterResponse<PaymentsTrackResponse> {
+    validate(&req)?;
+    let db = &*state.store;
+    let processor = platform.get_processor();
+    let processor_merchant_id = processor.get_account().get_id();
+    let storage_scheme = processor.get_account().storage_scheme;
+
+    let payment_intent = db
+        .find_payment_intent_by_payment_id_processor_merchant_id(
+            &req.payment_id,
+            processor_merchant_id,
+            processor.get_key_store(),
+            storage_scheme,
+        )
+        .await
+        .to_not_found_response(errors::ApiErrorResponse::PaymentNotFound)?;
+
+    utils::when(
+        !(payment_intent.status == enums::IntentStatus::Succeeded
+            || payment_intent.status == enums::IntentStatus::PartiallyCaptured),
+        || {
+            Err(report!(errors::ApiErrorResponse::PaymentUnexpectedState {
+                current_flow: "track".into(),
+                field_name: "status".into(),
+                current_value: payment_intent.status.to_string(),
+                states: "succeeded, partially_captured".to_string(),
+            })
+            .attach_printable("unable to track a payment that is not captured"))
+        },
+    )?;
+
+    let payment_attempt = db
+        .find_payment_attempt_last_successful_or_partially_captured_attempt_by_payment_id_processor_merchant_id(
+            &req.payment_id,
+            processor_merchant_id,
+            storage_scheme,
+            processor.get_key_store(),
+        )
+        .await
+        .to_not_found_response(errors::ApiErrorResponse::SuccessfulPaymentNotFound)?;
+
+    let connector_transaction_id = payment_attempt
+        .get_connector_payment_id()
+        .ok_or(errors::ApiErrorResponse::InternalServerError)
+        .attach_printable("connector_transaction_id missing on the successful payment attempt")?
+        .to_string();
+    let routed_through = payment_attempt
+        .connector
+        .clone()
+        .ok_or(errors::ApiErrorResponse::InternalServerError)
+        .attach_printable("Failed to retrieve connector from payment attempt")?;
+    let connector: api::ConnectorData = api::ConnectorData::get_connector_by_name(
+        &state.conf.connectors,
+        &routed_through,
+        api::GetToken::Connector,
+        payment_attempt.merchant_connector_id.clone(),
+    )?;
+    let profile_id = payment_intent
+        .profile_id
+        .as_ref()
+        .get_required_value("profile_id")
+        .change_context(errors::ApiErrorResponse::InternalServerError)
+        .attach_printable("profile_id is not set in payment_intent")?;
+    let merchant_connector_account = helpers::get_merchant_connector_account(
+        &state,
+        processor,
+        None,
+        profile_id,
+        &routed_through,
+        payment_attempt.merchant_connector_id.as_ref(),
+    )
+    .await?;
+
+    let mut router_data = construct_track_router_data(
+        &state,
+        &routed_through,
+        processor,
+        &payment_intent,
+        &payment_attempt,
+        &merchant_connector_account,
+        connector_transaction_id,
+        &req,
+    )?;
+
+    let lineage_ids = LineageIds::new(payment_intent.merchant_id.clone(), profile_id.clone());
+    let gateway_context = gateway_context::RouterGatewayContext {
+        creds_identifier: None,
+        processor: processor.clone(),
+        header_payload: HeaderPayload::default(),
+        lineage_ids,
+        merchant_connector_account: merchant_connector_account.clone(),
+        execution_path: common_enums::ExecutionPath::Direct,
+        execution_mode: common_enums::ExecutionMode::NotApplicable,
+    };
+    let add_access_token_result = Box::pin(access_token::add_access_token(
+        &state,
+        &connector,
+        &router_data,
+        None,
+        &gateway_context,
+        None,
+    ))
+    .await?;
+    access_token::update_router_data_with_access_token_result(
+        &add_access_token_result,
+        &mut router_data,
+        &payments::CallConnectorAction::Trigger,
+    );
+
+    let router_data = if add_access_token_result.connector_supports_access_token
+        && router_data.access_token.is_none()
+    {
+        // the access token call failed: its error is already in router_data.response
+        router_data
+    } else {
+        let connector_integration: services::BoxedPaymentConnectorIntegrationInterface<
+            api::Track,
+            types::PaymentsTrackData,
+            types::PaymentsTrackResponseData,
+        > = connector.connector.get_connector_integration();
+        services::execute_connector_processing_step(
+            &state,
+            connector_integration,
+            &router_data,
+            payments::CallConnectorAction::Trigger,
+            None,
+            None,
+        )
+        .await
+        .map_err(|err| to_api_error(err, &routed_through))?
+    };
+
+    let response = match router_data.response {
+        Ok(data) => PaymentsTrackResponse {
+            payment_id: req.payment_id.clone(),
+            status: PaymentsTrackStatus::Sent,
+            tracker_id: Some(data.tracker_id),
+            error_code: None,
+            error_message: None,
+        },
+        Err(err) if err.message == NOT_IMPLEMENTED_MESSAGE => {
+            return Err(report!(errors::ApiErrorResponse::FlowNotSupported {
+                flow: FLOW_NAME.to_string(),
+                connector: routed_through,
+            }));
+        }
+        Err(err)
+            if err.status_code >= 500
+                || err.status_code == 429
+                || err.code == interfaces_consts::REQUEST_TIMEOUT_ERROR_CODE =>
+        {
+            return Err(report!(errors::ApiErrorResponse::ExternalConnectorError {
+                code: err.code,
+                message: err.reason.unwrap_or(err.message),
+                connector: routed_through,
+                status_code: err.status_code,
+                reason: None,
+            }));
+        }
+        Err(err) => PaymentsTrackResponse {
+            payment_id: req.payment_id.clone(),
+            status: PaymentsTrackStatus::Failed,
+            tracker_id: None,
+            error_code: Some(err.code),
+            error_message: Some(err.reason.unwrap_or(err.message)),
+        },
+    };
+    Ok(services::ApplicationResponse::Json(response))
+}
+
+fn validate(req: &PaymentsTrackRequest) -> RouterResult<()> {
+    let number = req.tracking_number.trim();
+    utils::when(number.is_empty() || number.chars().count() > 64, || {
+        Err(report!(errors::ApiErrorResponse::InvalidDataFormat {
+            field_name: "tracking_number".to_string(),
+            expected_format: "1 to 64 characters".to_string(),
+        }))
+    })?;
+    let carrier = req.carrier.trim();
+    utils::when(carrier.is_empty() || carrier.chars().count() > 64, || {
+        Err(report!(errors::ApiErrorResponse::InvalidDataFormat {
+            field_name: "carrier".to_string(),
+            expected_format: "1 to 64 characters (connector carrier code)".to_string(),
+        }))
+    })?;
+    utils::when(
+        carrier == "OTHER"
+            && req
+                .carrier_name_other
+                .as_deref()
+                .map(str::trim)
+                .unwrap_or_default()
+                .is_empty(),
+        || {
+            Err(report!(errors::ApiErrorResponse::MissingRequiredField {
+                field_name: "carrier_name_other",
+            }))
+        },
+    )?;
+    for item in req.items.iter().flatten() {
+        utils::when(
+            item.name.trim().is_empty() || item.quantity.trim().is_empty(),
+            || {
+                Err(report!(errors::ApiErrorResponse::InvalidDataFormat {
+                    field_name: "items".to_string(),
+                    expected_format: "name and quantity per item".to_string(),
+                }))
+            },
+        )?;
+    }
+    Ok(())
+}
+
+/// Transport / encoding failures of the connector call (no HTTP answer to pass on).
+fn to_api_error(
+    err: error_stack::Report<errors::ConnectorError>,
+    connector: &str,
+) -> error_stack::Report<errors::ApiErrorResponse> {
+    let api_error = match err.current_context() {
+        errors::ConnectorError::NotImplemented(_) | errors::ConnectorError::FlowNotSupported { .. } => {
+            errors::ApiErrorResponse::FlowNotSupported {
+                flow: FLOW_NAME.to_string(),
+                connector: connector.to_string(),
+            }
+        }
+        // mergesk T3(2): the attempt lacks data the connector needs (PayPal: capture id in PaypalMeta) -> definite 4xx (spec 6 T3)
+        errors::ConnectorError::MissingConnectorRelatedTransactionID { id } => {
+            errors::ApiErrorResponse::PreconditionFailed {
+                message: format!("track: the successful payment attempt has no {id} for {connector} (not retryable)"),
+            }
+        }
+        errors::ConnectorError::MissingRequiredField { field_name } => {
+            errors::ApiErrorResponse::PreconditionFailed {
+                message: format!("track: the successful payment attempt has no {field_name} for {connector} (not retryable)"),
+            }
+        }
+        other => errors::ApiErrorResponse::ExternalConnectorError {
+            code: interfaces_consts::NO_ERROR_CODE.to_string(),
+            message: other.to_string(),
+            connector: connector.to_string(),
+            status_code: 500,
+            reason: None,
+        },
+    };
+    err.change_context(api_error)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn construct_track_router_data(
+    state: &SessionState,
+    connector_id: &str,
+    processor: &domain::Processor,
+    payment_intent: &storage::PaymentIntent,
+    payment_attempt: &storage::PaymentAttempt,
+    merchant_connector_account: &helpers::MerchantConnectorAccountType,
+    connector_transaction_id: String,
+    req: &PaymentsTrackRequest,
+) -> RouterResult<types::PaymentsTrackRouterData> {
+    let auth_type: types::ConnectorAuthType = merchant_connector_account
+        .get_connector_account_details()
+        .parse_value("ConnectorAuthType")
+        .change_context(errors::ApiErrorResponse::InternalServerError)?;
+    let payment_method = payment_attempt
+        .payment_method
+        .get_required_value("payment_method")
+        .change_context(errors::ApiErrorResponse::InternalServerError)?;
+    let tracking_number = req.tracking_number.trim().to_string();
+    let request = types::PaymentsTrackData {
+        connector_transaction_id,
+        connector_meta: payment_attempt.connector_metadata.clone(),
+        tracking_number: tracking_number.clone(),
+        carrier: req.carrier.trim().to_string(),
+        carrier_name_other: req
+            .carrier_name_other
+            .as_deref()
+            .map(str::trim)
+            .filter(|name| !name.is_empty())
+            .map(str::to_string),
+        notify_payer: req.notify_payer.unwrap_or(false),
+        items: req.items.clone().unwrap_or_default(),
+    };
+    Ok(types::RouterData {
+        flow: std::marker::PhantomData,
+        merchant_id: processor.get_account().get_id().clone(),
+        customer_id: payment_intent.customer_id.to_owned(),
+        tenant_id: state.tenant.tenant_id.clone(),
+        connector: connector_id.to_string(),
+        payment_id: payment_attempt.payment_id.get_string_repr().to_owned(),
+        attempt_id: payment_attempt.attempt_id.clone(),
+        status: payment_attempt.status,
+        payment_method,
+        payment_method_type: payment_attempt.payment_method_type,
+        connector_auth_type: auth_type,
+        description: None,
+        address: PaymentAddress::default(),
+        auth_type: payment_attempt.authentication_type.unwrap_or_default(),
+        connector_meta_data: merchant_connector_account.get_metadata(),
+        connector_wallets_details: merchant_connector_account.get_connector_wallets_details(),
+        amount_captured: payment_intent
+            .amount_captured
+            .map(|amt| amt.get_amount_as_i64()),
+        payment_method_status: None,
+        minor_amount_captured: payment_intent.amount_captured,
+        request,
+        response: Err(types::ErrorResponse {
+            code: interfaces_consts::NO_ERROR_CODE.to_string(),
+            message: NOT_IMPLEMENTED_MESSAGE.to_string(),
+            reason: None,
+            status_code: 501,
+            attempt_status: None,
+            connector_transaction_id: None,
+            connector_response_reference_id: None,
+            network_decline_code: None,
+            network_advice_code: None,
+            network_error_message: None,
+            connector_metadata: None,
+        }),
+        access_token: None,
+        session_token: None,
+        reference_id: None,
+        payment_method_token: None,
+        connector_customer: None,
+        recurring_mandate_payment_data: None,
+        preprocessing_id: None,
+        // PayPal sends this as PayPal-Request-Id (idempotency): one id per (attempt, tracking number) so a retry of the same
+        // number is deduplicated by PayPal while a second shipment of the same order is not.
+        connector_request_reference_id: format!(
+            "{}-track-{}",
+            payment_attempt.attempt_id, tracking_number
+        ),
+        #[cfg(feature = "payouts")]
+        payout_method_data: None,
+        #[cfg(feature = "payouts")]
+        quote_id: None,
+        test_mode: merchant_connector_account.is_test_mode_on(),
+        payment_method_balance: None,
+        connector_api_version: None,
+        connector_http_status_code: None,
+        external_latency: None,
+        apple_pay_flow: None,
+        frm_metadata: None,
+        refund_id: None,
+        dispute_id: None,
+        payout_id: None,
+        connector_response: None,
+        integrity_check: Ok(()),
+        additional_merchant_data: None,
+        header_payload: None,
+        connector_mandate_request_reference_id: None,
+        authentication_id: None,
+        psd2_sca_exemption_type: None,
+        raw_connector_response: None,
+        is_payment_id_from_merchant: None,
+        l2_l3_data: None,
+        minor_amount_capturable: None,
+        authorized_amount: None,
+        customer_document_details: None,
+        feature_data: None,
+        sender_payment_instrument_id: None,
+    })
+}
