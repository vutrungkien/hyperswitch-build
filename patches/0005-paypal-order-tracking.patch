+pub use self::mergesk_track::{PaypalTrackRequest, PaypalTrackResponse};
+
+/// mergesk patch 0005 (plan 33): request/response of `POST /v2/checkout/orders/{id}/track` (PayPal Orders v2
+/// "Add tracking information for an Order"). Own module so the file-level imports above (touched by patches 0001-0004) stay as they are.
+mod mergesk_track {
+    use hyperswitch_domain_models::{
+        router_flow_types::payments::Track, router_request_types::PaymentsTrackData,
+        router_response_types::PaymentsTrackResponseData, types::PaymentsTrackRouterData,
+    };
+
+    use super::*;
+
+    #[derive(Debug, Clone, Serialize, PartialEq)]
+    pub struct PaypalTrackRequest {
+        pub capture_id: String,
+        pub tracking_number: String,
+        pub carrier: String,
+        #[serde(skip_serializing_if = "Option::is_none")]
+        pub carrier_name_other: Option<String>,
+        pub notify_payer: bool,
+        #[serde(skip_serializing_if = "Option::is_none")]
+        pub items: Option<Vec<PaypalTrackItem>>,
+    }
+
+    #[derive(Debug, Clone, Serialize, PartialEq)]
+    pub struct PaypalTrackItem {
+        pub name: String,
+        pub quantity: String,
+    }
+
+    /// Body from the attempt's `PaypalMeta` (capture id) + the tracking request; no capture id -> the order was never captured here.
+    pub fn build_track_request(
+        connector_meta: Option<serde_json::Value>,
+        request: &PaymentsTrackData,
+    ) -> CustomResult<PaypalTrackRequest, errors::ConnectorError> {
+        let paypal_meta: PaypalMeta = to_connector_meta(connector_meta)?;
+        let capture_id = paypal_meta.capture_id.ok_or(
+            errors::ConnectorError::MissingConnectorRelatedTransactionID {
+                id: "capture_id".to_string(),
+            },
+        )?;
+        let items = if request.items.is_empty() {
+            None
+        } else {
+            Some(
+                request
+                    .items
+                    .iter()
+                    .map(|item| PaypalTrackItem {
+                        name: item.name.clone(),
+                        quantity: item.quantity.clone(),
+                    })
+                    .collect(),
+            )
+        };
+        Ok(PaypalTrackRequest {
+            capture_id,
+            tracking_number: request.tracking_number.clone(),
+            carrier: request.carrier.clone(),
+            carrier_name_other: request.carrier_name_other.clone(),
+            notify_payer: request.notify_payer,
+            items,
+        })
+    }
+
+    impl TryFrom<&PaymentsTrackRouterData> for PaypalTrackRequest {
+        type Error = error_stack::Report<errors::ConnectorError>;
+        fn try_from(item: &PaymentsTrackRouterData) -> Result<Self, Self::Error> {
+            build_track_request(item.request.connector_meta.clone(), &item.request)
+        }
+    }
+
+    /// 201 answers with the order; only the trackers of the purchase unit matter here (everything else is optional on purpose).
+    #[derive(Debug, Clone, Deserialize, Serialize)]
+    pub struct PaypalTrackResponse {
+        pub id: Option<String>,
+        pub status: Option<String>,
+        pub purchase_units: Option<Vec<PaypalTrackPurchaseUnit>>,
+    }
+
+    #[derive(Debug, Clone, Deserialize, Serialize)]
+    pub struct PaypalTrackPurchaseUnit {
+        pub shipping: Option<PaypalTrackShipping>,
+    }
+
+    #[derive(Debug, Clone, Deserialize, Serialize)]
+    pub struct PaypalTrackShipping {
+        pub trackers: Option<Vec<PaypalTracker>>,
+    }
+
+    #[derive(Debug, Clone, Deserialize, Serialize)]
+    pub struct PaypalTracker {
+        pub id: Option<String>,
+        pub status: Option<String>,
+    }
+
+    /// (tracker id, status): the tracker of the response that ends with `-{tracking_number}` (PayPal id = `{capture_id}-{tracking_number}`),
+    /// else that documented id with status SHIPPED (a 201 without trackers still means PayPal accepted it).
+    pub fn tracker_of(
+        response: &PaypalTrackResponse,
+        capture_id: &str,
+        tracking_number: &str,
+    ) -> (String, String) {
+        let suffix = format!("-{tracking_number}");
+        let found = response
+            .purchase_units
+            .iter()
+            .flatten()
+            .filter_map(|unit| unit.shipping.as_ref())
+            .filter_map(|shipping| shipping.trackers.as_ref())
+            .flatten()
+            .filter_map(|tracker| tracker.id.as_ref().map(|id| (id, tracker.status.as_ref())))
+            .filter(|(id, _)| id.ends_with(&suffix))
+            .last()
+            .map(|(id, status)| {
+                (
+                    id.clone(),
+                    status.cloned().unwrap_or_else(|| "SHIPPED".to_string()),
+                )
+            });
+        found.unwrap_or_else(|| (format!("{capture_id}{suffix}"), "SHIPPED".to_string()))
+    }
+
+    impl
+        TryFrom<
+            ResponseRouterData<Track, PaypalTrackResponse, PaymentsTrackData, PaymentsTrackResponseData>,
+        > for PaymentsTrackRouterData
+    {
+        type Error = error_stack::Report<errors::ConnectorError>;
+        fn try_from(
+            item: ResponseRouterData<
+                Track,
+                PaypalTrackResponse,
+                PaymentsTrackData,
+                PaymentsTrackResponseData,
+            >,
+        ) -> Result<Self, Self::Error> {
+            let paypal_meta: PaypalMeta = to_connector_meta(item.data.request.connector_meta.clone())?;
+            let capture_id = paypal_meta.capture_id.unwrap_or_default();
+            let (tracker_id, status) =
+                tracker_of(&item.response, &capture_id, &item.data.request.tracking_number);
+            Ok(Self {
+                response: Ok(PaymentsTrackResponseData { tracker_id, status }),
+                ..item.data
+            })
+        }
+    }
+
+    #[cfg(test)]
+    mod tests {
+        // mergesk patch 0005
+        use super::*;
+
+        fn meta(capture_id: Option<&str>) -> Option<serde_json::Value> {
+            Some(serde_json::json!({
+                "authorize_id": null,
+                "capture_id": capture_id,
+                "incremental_authorization_id": null,
+                "psync_flow": "CAPTURE",
+                "next_action": null,
+                "order_id": null
+            }))
+        }
+
+        fn request(items: Vec<(&str, &str)>, other: Option<&str>) -> PaymentsTrackData {
+            PaymentsTrackData {
+                connector_transaction_id: "1JB90045K08479115".to_string(),
+                connector_meta: meta(Some("3V0017519K696852K")),
+                tracking_number: "9400111899223".to_string(),
+                carrier: if other.is_some() { "OTHER" } else { "USPS" }.to_string(),
+                carrier_name_other: other.map(|s| s.to_string()),
+                notify_payer: false,
+                items: items
+                    .into_iter()
+                    .map(|(name, quantity)| api_models::payments::PaymentsTrackItem {
+                        name: name.to_string(),
+                        quantity: quantity.to_string(),
+                    })
+                    .collect(),
+            }
+        }
+
+        #[test]
+        fn body_has_capture_id_and_paypal_shape() {
+            let body = build_track_request(meta(Some("3V0017519K696852K")), &request(vec![("T-shirt", "2")], None)).unwrap();
+            let json = serde_json::to_value(&body).unwrap();
+            assert_eq!(
+                json,
+                serde_json::json!({
+                    "capture_id": "3V0017519K696852K",
+                    "tracking_number": "9400111899223",
+                    "carrier": "USPS",
+                    "notify_payer": false,
+                    "items": [{"name": "T-shirt", "quantity": "2"}]
+                })
+            );
+        }
+
+        #[test]
+        fn body_omits_empty_items_and_carries_other_name() {
+            let body = build_track_request(meta(Some("CAP1")), &request(vec![], Some("Giao Hang Nhanh"))).unwrap();
+            let json = serde_json::to_value(&body).unwrap();
+            assert_eq!(json.get("items"), None);
+            assert_eq!(json["carrier"], "OTHER");
+            assert_eq!(json["carrier_name_other"], "Giao Hang Nhanh");
+            let json = serde_json::to_value(build_track_request(meta(Some("CAP1")), &request(vec![], None)).unwrap()).unwrap();
+            assert_eq!(json.get("carrier_name_other"), None, "khong gui khoa rong");
+        }
+
+        #[test]
+        fn missing_capture_id_is_a_connector_error() {
+            let err = build_track_request(meta(None), &request(vec![], None)).unwrap_err();
+            assert!(matches!(
+                err.current_context(),
+                errors::ConnectorError::MissingConnectorRelatedTransactionID { id } if id == "capture_id"
+            ));
+        }
+
+        #[test]
+        fn tracker_id_prefers_matching_tracker_else_documented_id() {
+            let full: PaypalTrackResponse = serde_json::from_value(serde_json::json!({
+                "id": "1JB90045K08479115",
+                "status": "COMPLETED",
+                "purchase_units": [{"reference_id": "default", "shipping": {"trackers": [
+                    {"id": "3V0017519K696852K-OLD1", "status": "SHIPPED"},
+                    {"id": "3V0017519K696852K-9400111899223", "status": "ON_HOLD", "items": []}
+                ]}, "payments": {"captures": [{"id": "3V0017519K696852K"}]}}],
+                "links": []
+            }))
+            .unwrap();
+            assert_eq!(
+                tracker_of(&full, "3V0017519K696852K", "9400111899223"),
+                ("3V0017519K696852K-9400111899223".to_string(), "ON_HOLD".to_string())
+            );
+            let bare: PaypalTrackResponse = serde_json::from_value(serde_json::json!({"id": "x"})).unwrap();
+            assert_eq!(
+                tracker_of(&bare, "3V0017519K696852K", "9400111899223"),
+                ("3V0017519K696852K-9400111899223".to_string(), "SHIPPED".to_string())
+            );
+        }
+    }
+}
